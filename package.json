{
  "name": "hotdeal-server",
  "version": "1.0.0",
  "description": "뽐뿌/퀘이사존/클리앙/어미새/루리웹 핫딜을 1시간마다 크롤링해서 비교해주는 서버",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "crawl": "node -e \"require('./crawler').runFullCrawl().then(()=>process.exit(0))\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "iconv-lite": "^0.6.3",
    "node-cron": "^3.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
